rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isFarmer() {
      return signedIn() && get(userPath(request.auth.uid)).data.role == 'farmer';
    }

    function isWarehouse() {
      return signedIn() && get(userPath(request.auth.uid)).data.role == 'warehouse';
    }

    function validDryingStatus(value) {
      return value == null || value == 'GOOD' || value == 'NOT GOOD' || value == 'BAD TIME';
    }

    function validDeliveryStatus(value) {
      return value == 'Scheduled' || value == 'In Transit' || value == 'Received' || value == 'Cancelled';
    }

    function isNumber(value) {
      return value is int || value is float;
    }

    function validDisplayCode(value, prefix) {
      return value is string && value.matches('^' + prefix + '-[A-HJ-NP-Z2-9]{6}$');
    }

    function displayCodePath(code) {
      return /databases/$(database)/documents/display_codes/$(code);
    }

    function sequenceCounterPath(counterId) {
      return /databases/$(database)/documents/sequence_counters/$(counterId);
    }

    function validIotSessionId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,100}$');
    }

    function iotSessionLinkPath(sessionId) {
      return /databases/$(database)/documents/iot_session_links/$(sessionId);
    }

    function validIotLinkAfter(sessionId, batchId, ownerUid) {
      return existsAfter(iotSessionLinkPath(sessionId))
             && getAfter(iotSessionLinkPath(sessionId)).data.sessionId == sessionId
             && getAfter(iotSessionLinkPath(sessionId)).data.batchId == batchId
             && getAfter(iotSessionLinkPath(sessionId)).data.ownerUid == ownerUid;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || (isFarmer() && resource.data.role == 'warehouse'));
      allow list: if isFarmer() && resource.data.role == 'warehouse';
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role;
      allow create, delete: if false;
    }

    match /copra_batches/{batchId} {
      allow read: if isFarmer();
      allow create: if isFarmer()
                    && request.resource.data.batchId == batchId
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.batchDate is timestamp
                    && request.resource.data.batchStatus == 'active'
                    && (
                      (request.resource.data.keys().hasOnly(['batchId', 'batchNumber', 'createdBy', 'batchDate', 'batchStatus'])
                        && request.resource.data.batchNumber is int
                        && request.resource.data.batchNumber > 0
                        && existsAfter(sequenceCounterPath('batches'))
                        && getAfter(sequenceCounterPath('batches')).data.currentValue == request.resource.data.batchNumber
                        && getAfter(sequenceCounterPath('batches')).data.lastRecordId == batchId
                        && getAfter(sequenceCounterPath('batches')).data.updatedBy == request.auth.uid)
                      ||
                      (request.resource.data.keys().hasOnly(['batchId', 'batchNumber', 'createdBy', 'batchDate', 'batchStatus', 'iotSessionId'])
                        && request.resource.data.batchNumber is int
                        && request.resource.data.batchNumber > 0
                        && validIotSessionId(request.resource.data.iotSessionId)
                        && batchId == 'IOT_' + request.resource.data.iotSessionId
                        && validIotLinkAfter(request.resource.data.iotSessionId, batchId, request.auth.uid)
                        && existsAfter(sequenceCounterPath('batches'))
                        && getAfter(sequenceCounterPath('batches')).data.currentValue == request.resource.data.batchNumber
                        && getAfter(sequenceCounterPath('batches')).data.lastRecordId == batchId
                        && getAfter(sequenceCounterPath('batches')).data.updatedBy == request.auth.uid)
                      ||
                      (request.resource.data.keys().hasOnly(['batchId', 'displayCode', 'createdBy', 'batchDate', 'batchStatus'])
                        && validDisplayCode(request.resource.data.displayCode, 'B')
                        && existsAfter(displayCodePath(request.resource.data.displayCode))
                        && getAfter(displayCodePath(request.resource.data.displayCode)).data.kind == 'batch'
                        && getAfter(displayCodePath(request.resource.data.displayCode)).data.recordId == batchId
                        && getAfter(displayCodePath(request.resource.data.displayCode)).data.ownerUid == request.auth.uid)
                    );
      allow update: if isFarmer()
                    && resource.data.createdBy == request.auth.uid
                    && resource.data.batchStatus == 'active'
                    && (
                      (
                        request.resource.data.batchStatus == 'completed'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'batchStatus', 'completedAt', 'completedBy'
                        ])
                        && request.resource.data.completedBy == request.auth.uid
                        && request.resource.data.completedAt is timestamp
                        && request.resource.data.completedAt == request.time
                      )
                      ||
                      (
                        request.resource.data.batchStatus == 'active'
                        && !resource.data.keys().hasAny(['iotSessionId'])
                        && request.resource.data.diff(resource.data).addedKeys().hasAll(['iotSessionId'])
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['iotSessionId'])
                        && validIotSessionId(request.resource.data.iotSessionId)
                        && validIotLinkAfter(request.resource.data.iotSessionId, batchId, request.auth.uid)
                      )
                    );
      allow delete: if false;
    }

    match /iot_session_links/{sessionId} {
      allow get: if isFarmer();
      allow list: if false;
      allow create: if isFarmer()
                    && validIotSessionId(sessionId)
                    && request.resource.data.keys().hasOnly(['sessionId', 'batchId', 'ownerUid', 'createdAt'])
                    && request.resource.data.sessionId == sessionId
                    && request.resource.data.batchId is string
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.createdAt == request.time
                    && existsAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.batchId))
                    && getAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.batchId)).data.createdBy == request.auth.uid
                    && getAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.batchId)).data.iotSessionId == sessionId;
      allow update, delete: if false;
    }

    match /monitoring_records/{monitoringId} {
      allow read: if isFarmer();
      allow write: if false;
    }

    match /weight_records/{weightId} {
      allow read: if isFarmer();
      allow create: if isFarmer()
                    && request.resource.data.weightId == weightId
                    && isNumber(request.resource.data.weight)
                    && request.resource.data.weight > 0
                    && request.resource.data.recordedAt is timestamp
                    && (
                      (request.resource.data.keys().hasAll(['weightId', 'batchId', 'weight', 'recordedAt'])
                        && request.resource.data.keys().hasOnly(['weightId', 'batchId', 'weight', 'recordedAt'])
                        && request.resource.data.batchId is string
                        && existsAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.batchId))
                        && getAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.batchId)).data.createdBy == request.auth.uid)
                      ||
                      (request.resource.data.keys().hasAll(['weightId', 'deliveryId', 'sackId', 'weight', 'recordedAt'])
                        && request.resource.data.keys().hasOnly(['weightId', 'deliveryId', 'sackId', 'weight', 'recordedAt'])
                        && request.resource.data.deliveryId is string
                        && request.resource.data.sackId is string
                        && request.resource.data.sackId.matches('^[A-Za-z0-9_-]{1,80}$')
                        && weightId == request.resource.data.deliveryId + '_' + request.resource.data.sackId
                        && existsAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.deliveryId))
                        && getAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.deliveryId)).data.createdBy == request.auth.uid)
                    );
      allow update, delete: if false;
    }

    match /alert_records/{alertId} {
      allow read: if isFarmer();
      allow update: if isFarmer()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
                    && request.resource.data.isRead == true
                    && request.resource.data.readAt is timestamp;
      allow create, delete: if false;
    }

    match /delivery_records/{deliveryId} {
      allow read: if signedIn()
                  && ((isFarmer() && resource.data.createdBy == request.auth.uid)
                      || (isWarehouse() && resource.data.warehouseUserId == request.auth.uid));

      allow create: if isFarmer()
                    && request.resource.data.keys().hasOnly([
                      'deliveryId', 'displayCode', 'deliveryNumber', 'batchId', 'warehouseUserId', 'createdBy', 'updatedBy',
                      'deliveryWeight', 'createdAt', 'deliveryDate', 'deliveryStatus'
                    ])
                    && request.resource.data.deliveryId == deliveryId
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == null
                    && request.resource.data.warehouseUserId is string
                    && get(userPath(request.resource.data.warehouseUserId)).data.role == 'warehouse'
                    && (!request.resource.data.keys().hasAny(['batchId'])
                        || (request.resource.data.batchId is string
                            && get(/databases/$(database)/documents/copra_batches/$(request.resource.data.batchId)).data.createdBy == request.auth.uid))
                    && (!request.resource.data.keys().hasAny(['deliveryWeight'])
                        || (isNumber(request.resource.data.deliveryWeight)
                            && request.resource.data.deliveryWeight > 0))
                    && (!request.resource.data.keys().hasAny(['createdAt'])
                        || (request.resource.data.createdAt is timestamp
                            && request.resource.data.createdAt == request.time))
                    && request.resource.data.deliveryDate is timestamp
                    && request.resource.data.deliveryStatus == 'Scheduled'
                    && (
                      (request.resource.data.keys().hasAny(['deliveryNumber'])
                        && !request.resource.data.keys().hasAny(['displayCode'])
                        && request.resource.data.deliveryNumber is int
                        && request.resource.data.deliveryNumber > 0
                        && request.resource.data.createdAt is timestamp
                        && request.resource.data.createdAt == request.time
                        && existsAfter(sequenceCounterPath('deliveries'))
                        && getAfter(sequenceCounterPath('deliveries')).data.currentValue == request.resource.data.deliveryNumber
                        && getAfter(sequenceCounterPath('deliveries')).data.lastRecordId == deliveryId
                        && getAfter(sequenceCounterPath('deliveries')).data.updatedBy == request.auth.uid)
                      ||
                      (!request.resource.data.keys().hasAny(['deliveryNumber'])
                        && request.resource.data.keys().hasAny(['displayCode'])
                        && validDisplayCode(request.resource.data.displayCode, 'D')
                        && existsAfter(displayCodePath(request.resource.data.displayCode))
                        && getAfter(displayCodePath(request.resource.data.displayCode)).data.kind == 'delivery'
                        && getAfter(displayCodePath(request.resource.data.displayCode)).data.recordId == deliveryId
                        && getAfter(displayCodePath(request.resource.data.displayCode)).data.ownerUid == request.auth.uid)
                    );

      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryStatus', 'updatedBy'])
                    && request.resource.data.updatedBy == request.auth.uid
                    && validDeliveryStatus(request.resource.data.deliveryStatus)
                    && (
                      (isFarmer()
                        && resource.data.createdBy == request.auth.uid
                        && resource.data.deliveryStatus == 'Scheduled'
                        && (request.resource.data.deliveryStatus == 'In Transit' || request.resource.data.deliveryStatus == 'Cancelled'))
                      ||
                      (isWarehouse()
                        && resource.data.warehouseUserId == request.auth.uid
                        && resource.data.deliveryStatus == 'In Transit'
                        && request.resource.data.deliveryStatus == 'Received')
                    );
      allow delete: if false;
    }

    match /sequence_counters/{counterId} {
      allow get: if isFarmer() && (counterId == 'batches' || counterId == 'deliveries');
      allow list: if false;
      allow create: if isFarmer()
                    && (counterId == 'batches' || counterId == 'deliveries')
                    && request.resource.data.keys().hasOnly(['kind', 'currentValue', 'lastRecordId', 'updatedBy', 'updatedAt'])
                    && request.resource.data.kind == (counterId == 'batches' ? 'batch' : 'delivery')
                    && request.resource.data.currentValue == 1
                    && request.resource.data.lastRecordId is string
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.updatedAt == request.time
                    && (
                      (counterId == 'batches'
                        && existsAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.lastRecordId))
                        && getAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.lastRecordId)).data.batchNumber == 1
                        && getAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.lastRecordId)).data.createdBy == request.auth.uid)
                      ||
                      (counterId == 'deliveries'
                        && existsAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.lastRecordId))
                        && getAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.lastRecordId)).data.deliveryNumber == 1
                        && getAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.lastRecordId)).data.createdBy == request.auth.uid)
                    );
      allow update: if isFarmer()
                    && (counterId == 'batches' || counterId == 'deliveries')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentValue', 'lastRecordId', 'updatedBy', 'updatedAt'])
                    && request.resource.data.kind == resource.data.kind
                    && request.resource.data.currentValue == resource.data.currentValue + 1
                    && request.resource.data.lastRecordId is string
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.updatedAt == request.time
                    && (
                      (counterId == 'batches'
                        && resource.data.kind == 'batch'
                        && existsAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.lastRecordId))
                        && getAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.lastRecordId)).data.batchNumber == request.resource.data.currentValue
                        && getAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.lastRecordId)).data.createdBy == request.auth.uid)
                      ||
                      (counterId == 'deliveries'
                        && resource.data.kind == 'delivery'
                        && existsAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.lastRecordId))
                        && getAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.lastRecordId)).data.deliveryNumber == request.resource.data.currentValue
                        && getAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.lastRecordId)).data.createdBy == request.auth.uid)
                    );
      allow delete: if false;
    }

    match /display_codes/{displayCode} {
      allow get: if isFarmer();
      allow list: if false;
      allow create: if isFarmer()
                    && request.resource.data.keys().hasOnly([
                      'displayCode', 'kind', 'recordId', 'ownerUid', 'createdAt'
                    ])
                    && request.resource.data.displayCode == displayCode
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.recordId is string
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.createdAt == request.time
                    && (
                      (request.resource.data.kind == 'batch'
                        && validDisplayCode(displayCode, 'B')
                        && existsAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.recordId))
                        && getAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.recordId)).data.displayCode == displayCode
                        && getAfter(/databases/$(database)/documents/copra_batches/$(request.resource.data.recordId)).data.createdBy == request.auth.uid)
                      ||
                      (request.resource.data.kind == 'delivery'
                        && validDisplayCode(displayCode, 'D')
                        && existsAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.recordId))
                        && getAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.recordId)).data.displayCode == displayCode
                        && getAfter(/databases/$(database)/documents/delivery_records/$(request.resource.data.recordId)).data.createdBy == request.auth.uid)
                    );
      allow update, delete: if false;
    }
  }
}
